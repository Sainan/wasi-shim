local wasm = require "pluto:wasm"

local shimModule = io.contents(io.part(debug.getinfo(1, "S").source:sub(2)) .. "/shim.wasm")

local function runWasiProgram(bytes, options = {})
	options.argv ??= {}
	options.stdout ??= io.write
	options.stderr ??= io.write
	options.files ??= {}

	local programInstance, exit_code
	local glue = {
		read_i32 = |addr| -> (string.unpack("<I4", programInstance:read(addr, 4))),
		write_i8 = |addr, value| -> do programInstance:write(addr, string.pack("I1", value)) end,
		write_i16 = |addr, value| -> do programInstance:write(addr, string.pack("<I2", value)) end,
		write_i32 = |addr, value| -> do programInstance:write(addr, string.pack("<I4", value)) end,
		write_i64 = |addr, value| -> do programInstance:write(addr, string.pack("<I8", value)) end,

		stdout_write = |addr, len| -> do options.stdout(programInstance:read(addr, len)) end,
		stderr_write = |addr, len| -> do options.stderr(programInstance:read(addr, len)) end,

		get_num_args = || -> #options.argv,
		get_combined_args_size = || -> options.argv:reduce(|accum, arg| -> accum + #arg, 0),
		get_arg = |addr, index| -> do
			programInstance:write(addr, options.argv[1 + index])
			return #options.argv[1 + index]
		end,

		file_name_to_index = |addr, len| -> do
			local name = programInstance:read(addr, len)
			return (options.files:findindex(|file| -> file.name == name) or 0) - 1
		end,
		file_size = |file_index| -> #options.files[1 + file_index].data,
		file_read = |file_index, offset, buf, len| -> do
			local available = #options.files[1 + file_index].data - offset
			local nread = math.min(len, available)
			programInstance:write(buf, options.files[1 + file_index].data:span(1 + offset, nread))
			return nread
		end,

		set_exit_code = |value| -> do
			exit_code = value
			error({ __wasi_exit = 1 })
		end,
	}
	local shimInstance = wasm.instantiate(shimModule, $object(glue))
	programInstance = wasm.instantiate(bytes, {
		wasi_snapshot_preview1 = setmetatable({}, {
			function __index(key)
				--print("__index", key)
				return function(...)
					--print("call", key)
					return shimInstance:call(key, ...)
				end
			end
		})
	})
	local ok, err = pcall(programInstance.call, programInstance, "_start")
	if not ok and not (type(err) == "table" and err.__wasi_exit) then
		error(err)
	end
	return exit_code
end

return runWasiProgram
